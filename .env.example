# Application Configuration
APP_NAME="VisionAttend AI - Enterprise Face Attendance System"
APP_ENV=development
DEBUG=True
PORT=8000
HOST=0.0.0.0

# Security
SECRET_KEY=super-secret-visionattend-key-change-in-production-2026-xyz
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/attendance.db

# Face Recognition & AI Settings
FACE_DETECTION_CONFIDENCE=0.75
FACE_RECOGNITION_THRESHOLD=0.58
LIVENESS_DETECTION_ENABLED=True
LIVENESS_THRESHOLD=0.65
ANTI_SPOOF_METHOD=frequency_and_motion

# Attendance Policy
ATTENDANCE_COOLDOWN_MINUTES=5
OFFICE_START_TIME=09:00:00
OFFICE_LATE_THRESHOLD=09:30:00
OFFICE_END_TIME=18:00:00
AUTO_CHECKOUT_ENABLED=True

# Storage
DATA_DIR=./data
FACES_DIR=./storage/faces
EXPORTS_DIR=./storage/exports
